mock-components/**
# mock-dezi, mock-prs and mitz are part of the root Go module and are built
# from the repo root context, like sandbox/app; the other mock-components are
# separate stacks with their own build context and stay excluded from this one.
!mock-components/dezi/**
!mock-components/prs/**
!mock-components/mitz/**

# Demo CA and signing keys from sandbox/generate-demo-certs.sh. Gitignored,
# but the Dockerfiles built from this context still do `COPY . .`, which
# would otherwise pull them into the builder stage regardless of git
# tracking. Keep this rule after the negation above so it is not
# re-included by it.
sandbox/.certs/

# Private key material and local runtime state, excluded by shape rather
# than by location so a new key directory does not silently start shipping.
# `pki/cacerts/*.crt`, the only certificate material most images need, is
# public and unaffected.
**/*.key
**/*_private.pem
data/

# Test UZI keys the seed image (test/testdata/Dockerfile) bakes in to issue
# demo X509Credentials. Fake, committed deliberately (see
# test/e2e/pep/certs/README.md) — not real key material.
!test/e2e/pep/certs/*.key