      "updated": 1789390163378,
      "link": null,
      "locked": false,
      "text": "Client engine\nclassify + log every bundle\nout-of-band bootstrap: fetch\nSubscription,\nenforce agreed topic / mode\ncontinuity check: $events, else $status\n+ gap\nidempotency (subscription, event-\nnumber)\nheartbeat-miss timer: $status\nnormalised inbox",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "36GsGRNqPbvKorjDVGV0X",
      "originalText": "Client engine\nclassify + log every bundle\nout-of-band bootstrap: fetch Subscription,\nenforce agreed topic / mode\ncontinuity check: $events, else $status + gap\nidempotency (subscription, event-number)\nheartbeat-miss timer: $status\nnormalised inbox",
      "autoResize": true,
      "lineHeight": 1.25
    },
